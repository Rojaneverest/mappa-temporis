{
  "name": "mappa-temporis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build:chart": "for f in content/sheets/*.yaml; do node scripts/build-chart.ts $(basename $f .yaml) || exit 1; done",
    "images": "node scripts/images/pipeline.ts",
    "coverage": "node scripts/coverage.ts",
    "density": "node scripts/density.ts",
    "atlas": "for f in content/sheets/*.yaml; do node scripts/atlas/build-atlas.ts $(basename $f .yaml) || exit 1; done && node scripts/atlas/power.ts",
    "build:tools": "mkdir -p tools/bin && swiftc -O tools/cutout/cutout.swift -o tools/bin/cutout",
    "dev": "pnpm build:chart && pnpm --filter explorer dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.0.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "canvaskit-wasm": "0.42.0",
    "d3-geo": "3.1.1",
    "flatbush": "^4.6.2",
    "mapshaper": "^0.7.95",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
